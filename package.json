{
  "name": "active-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --watch",
    "build": "npx tailwindcss -i ./resources/css/app.css -o ./public/assets/css/app.css --minify",
    "sync": "copy /Y public\\assets\\css\\app.css assets\\css\\app.css",
    "migrate": "php database/migrate.php",
    "serve": "php -S localhost:8000 -t public"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "puppeteer": "^25.18.1",
    "tailwindcss": "^3.4.0"
  }
}
